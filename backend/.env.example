NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://localhost:27017/civicpulse
JWT_SECRET=your_jwt_secret_at_least_32_characters_long_here
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:5000   # used to build image links for uploads

# Admin seeding (used only by `npm run seed:admin`)
SEED_ADMIN_EMAIL=admin@civicpulse.local
SEED_ADMIN_PASSWORD=SecurePassword123!
SEED_ADMIN_NAME=System Administrator

# Hugging Face API Configuration
# Get API key from https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=your_hugging_face_api_key_here

# Recommended Hugging Face Models for CivicPulse
# Image Classification Model (detects civic issues from images)
HF_IMAGE_MODEL=google/vit-base-patch16-224

# Image Embedding Model (generates image vectors for similarity)
HF_IMAGE_EMBEDDING_MODEL=sentence-transformers/clip-vit-base-patch32

# Text Embedding Model (generates text vectors for semantic similarity)
HF_TEXT_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Cloudinary Configuration (OPTIONAL — see note below)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# NOTE: image uploads currently write to local disk (./uploads, served at /uploads — see
# services/StorageService.ts) so the app runs out of the box with zero storage setup. Cloudinary
# vars are read by nothing yet; they're reserved for swapping StorageService.saveBase64Image to
# Cloudinary before a real deployment, since local disk storage doesn't survive most PaaS redeploys.

# Demo data seeding (used only by `npm run seed:demo`)
SEED_DEMO_PASSWORD=DemoPass123!

# Duplicate Detection Configuration
DUPLICATE_SEARCH_RADIUS_METERS=500
DUPLICATE_THRESHOLD=0.6

# Similarity Calculation Weights
# These must sum to 1.0
IMAGE_SIMILARITY_WEIGHT=0.4
TEXT_SIMILARITY_WEIGHT=0.35
LOCATION_WEIGHT=0.15
CATEGORY_WEIGHT=0.1

# Notes (Phase 3)
# - Duplicate-detection weights/thresholds and model names above are only DEFAULTS.
#   Administrators can override them at /admin/ai-configuration (stored in MongoDB).
# - HUGGINGFACE_API_KEY is only ever read from this file; it is never stored in the database or returned by any API.
